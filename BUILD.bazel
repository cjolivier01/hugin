load("//tools/cmake:cmake_build.bzl", "cmake_build")

# Group all source files except build outputs and VCS metadata
filegroup(
    name = "hugin_srcs",
    srcs = glob([
        "**/*",
    ], exclude = [
        "MODULE.bazel",
        "**/*.swp",
        "**/*.swo",
        "**/*.pyc",
        "**/.DS_Store",
        ".git/**",
        "_sanity_build/**",
        "bazel-*/**",
        "_bazel*/**",
        "build/**",
        "out/**",
        # Avoid including Bazel outputs in recursive builds
        "bazel-out/**",
    ]),
)

# Build Hugin via CMake inside Bazel using rules_foreign_cc.
# This uses the existing CMakeLists.txt and installs into a sandboxed prefix.
cmake_build(
    name = "hugin_all",
    srcs = [":hugin_srcs"],
    cache_entries = {
        "CMAKE_BUILD_TYPE": "Release",
        "DISABLE_DPKG": "ON",
    },
    # Build default target and then run `cmake --install` into the output tree.
    targets = [],
    build_args = [],
)

# Build only the command-line tools used by HockeyMON.
cmake_build(
    name = "cmdline-tools",
    srcs = [":hugin_srcs"],
    cache_entries = {
        "CMAKE_BUILD_TYPE": "Release",
        "DISABLE_DPKG": "ON",
    },
    # Limit the CMake build to these targets for faster builds.
    targets = [
        "pto_gen",
        "autooptimiser",
        "nona",
    ],
    build_args = [],
    tags = ["manual"],
)

# Convenience target to access the staged install tree produced by the CMake build.
# This preserves the previous behavior of `//:install_tree` before it became runnable.
alias(
    name = "staged_install_tree",
    actual = ":hugin_all",
)

alias(
    name = "pto_gen",
    actual = ":cmdline-tools",
)

alias(
    name = "autooptimiser",
    actual = ":cmdline-tools",
)

alias(
    name = "nona",
    actual = ":cmdline-tools",
)

# Runnable installer: builds with CMake and installs to an optional --prefix.
# Usage:
#   bazel run //:install_tree -- --prefix=/usr/local
genrule(
    name = "install_tree",
    srcs = ["//tools/cmake:install_tree.sh"],
    tools = [":hugin_all"],
    outs = ["install_tree_runner.sh"],
    cmd = """
printf '%s\n' \
'#!/usr/bin/env bash' \
'set -euo pipefail' \
'\"$(location //tools/cmake:install_tree.sh)\" --staged-tree=\"$(location :hugin_all)\" \"$$@\"' \
> $@
chmod +x $@
""",
    executable = True,
)
