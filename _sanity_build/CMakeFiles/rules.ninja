  command = $PRE_LINK && /usr/bin/c++ $FLAGS $LINK_FLAGS $in -o $TARGET_FILE $LINK_PATH $LINK_LIBRARIES && $POST_BUILD
  description = Linking CXX executable $TARGET_FILE
  restat = $RESTAT


#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = /home/colivier/miniforge3/envs/ubuntu/bin/cmake --regenerate-during-build -S/home/colivier/src/hm2/external/hugin -B/home/colivier/src/hm2/external/hugin/_sanity_build
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = /home/colivier/miniforge3/envs/ubuntu/bin/ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = /home/colivier/miniforge3/envs/ubuntu/bin/ninja -t targets
  description = All primary targets available:

